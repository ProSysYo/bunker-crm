# ---------------------------------------------------------------------------
# Монорепозиторий (client/ + api/)
# Паттерны не заякорены на корень (без ведущего /),
# чтобы работать во всех подпапках.
# ---------------------------------------------------------------------------

# --- Node / Next.js (client) ---
node_modules/
.next/
out/
coverage/
.vercel
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- NestJS / Node (api) ---
dist/

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- npm/yarn/pnpm логи ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Секреты ---
# Игнорируем все env-файлы, но примеры коммитим намеренно.
.env
.env.*
!.env.example

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
*.pem
.idea/
