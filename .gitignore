# ---------------------------------------------------------------------------
# Общие правила для монорепозитория (frontend/ + backend/)
# Паттерны не заякорены на корень, чтобы работать во всех подпапках.
# ---------------------------------------------------------------------------

# --- Node / Next.js (frontend) ---
node_modules/
.next/
out/
coverage/
.vercel
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# TypeScript
*.tsbuildinfo
next-env.d.ts

# npm/yarn/pnpm логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.sqlite3

# --- Секреты ---
# Игнорируем все env-файлы, но примеры коммитим намеренно.
.env
.env.*
!.env.example

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
*.pem
.idea/
